# 仅本地 `npm run dev` 需要；线上在项目「设置 → 变量和机密 → 添加」逐项配置（密钥类点「加密」）
# 注意：KV 命名空间绑定不在这里！在「设置 → 绑定 → 添加 → KV namespace」，变量名必须填 NAV_KV
# 仓库根不要放 wrangler.toml，否则上面两个入口都会被 Cloudflare 禁用（详见 wrangler.toml.example）
# 复制为 .dev.vars 后填写，该文件已 gitignore，切勿提交

# 管理员用户名（默认 admin）
ADMIN_USERNAME=admin

# PBKDF2 口令哈希，生成方式（在 cf/ 目录执行）：
#   node scripts/hash-password.mjs '你的新密码'
# 取等号右侧整串填入
ADMIN_PASSWORD_HASH=

# 会话签名密钥，生成：node -p "require('crypto').randomBytes(32).toString('hex')"
SESSION_SECRET=

# 一键添加书签 token（可选，不填则 jsadd 接口不可用）
# 生成：node -p "require('crypto').randomBytes(24).toString('hex')"
JSADD_TOKEN=
