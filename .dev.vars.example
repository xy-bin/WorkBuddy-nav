# 仅本地 `npm run dev` 需要；线上在 Pages 项目 Settings → Environment variables 配置（密码类选 Encrypt）
# 复制为 .dev.vars 后填写，该文件已 gitignore，切勿提交

# 管理员用户名（默认 admin）
ADMIN_USERNAME=admin

# PBKDF2 口令哈希，生成方式（在 cf/ 目录执行）：
#   node scripts/hash-password.mjs '你的新密码'
# 取等号右侧整串填入
ADMIN_PASSWORD_HASH=

# 会话签名密钥，生成：node -p "require('crypto').randomBytes(32).toString('hex')"
SESSION_SECRET=

# 一键添加书签 token（可选，不填则 jsadd 接口不可用）
# 生成：node -p "require('crypto').randomBytes(24).toString('hex')"
JSADD_TOKEN=
